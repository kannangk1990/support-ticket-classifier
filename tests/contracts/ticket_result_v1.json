{
  "$defs": {
    "ClassificationStatus": {
      "enum": [
        "classified",
        "flagged_injection",
        "fallback"
      ],
      "title": "ClassificationStatus",
      "type": "string"
    },
    "IssueCategory": {
      "enum": [
        "order_issue",
        "payment_issue",
        "delivery_issue",
        "product_issue",
        "account_issue",
        "refund_request",
        "other"
      ],
      "title": "IssueCategory",
      "type": "string"
    },
    "PiiType": {
      "enum": [
        "email",
        "phone",
        "card",
        "iban",
        "ssn",
        "ip_address"
      ],
      "title": "PiiType",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ReviewReason": {
      "enum": [
        "low_confidence",
        "critical_priority",
        "uncategorised",
        "injection_suspected",
        "classifier_unavailable",
        "pii_in_output"
      ],
      "title": "ReviewReason",
      "type": "string"
    },
    "Sentiment": {
      "enum": [
        "positive",
        "neutral",
        "negative",
        "angry"
      ],
      "title": "Sentiment",
      "type": "string"
    },
    "Team": {
      "enum": [
        "fulfillment_team",
        "payments_team",
        "logistics_team",
        "customer_support",
        "tech_team"
      ],
      "title": "Team",
      "type": "string"
    },
    "Usage": {
      "properties": {
        "api_equivalent_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Api Equivalent Cost Usd"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "duration_ms",
        "api_equivalent_cost_usd"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "properties": {
    "assigned_team": {
      "$ref": "#/$defs/Team"
    },
    "attempts": {
      "title": "Attempts",
      "type": "integer"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    },
    "issue_category": {
      "$ref": "#/$defs/IssueCategory"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model"
    },
    "pii_redacted": {
      "items": {
        "$ref": "#/$defs/PiiType"
      },
      "title": "Pii Redacted",
      "type": "array"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "reasoning": {
      "title": "Reasoning",
      "type": "string"
    },
    "redacted_text": {
      "title": "Redacted Text",
      "type": "string"
    },
    "requires_human_review": {
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "review_reasons": {
      "items": {
        "$ref": "#/$defs/ReviewReason"
      },
      "title": "Review Reasons",
      "type": "array"
    },
    "sentiment": {
      "$ref": "#/$defs/Sentiment"
    },
    "status": {
      "$ref": "#/$defs/ClassificationStatus"
    },
    "ticket_id": {
      "title": "Ticket Id",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ticket_id",
    "status",
    "issue_category",
    "assigned_team",
    "priority",
    "sentiment",
    "confidence",
    "reasoning",
    "requires_human_review",
    "review_reasons",
    "pii_redacted",
    "redacted_text",
    "prompt_version",
    "model",
    "attempts",
    "usage"
  ],
  "title": "TicketResult",
  "type": "object"
}
