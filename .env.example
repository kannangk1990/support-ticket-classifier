# Copy to .env to override defaults. All settings are optional.
#
# Do NOT add ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN anywhere: this project runs on
# your Claude subscription (sign in with `claude` -> /login) and refuses to start if
# API credentials are present.

TICKET_CLAUDE_MODEL=claude-opus-5-5
TICKET_EFFORT=low
TICKET_PROMPT_VERSION=v1
TICKET_LLM_TIMEOUT_SECONDS=120
TICKET_MAX_ATTEMPTS=2
TICKET_MAX_CONCURRENCY=2
TICKET_REVIEW_CONFIDENCE_THRESHOLD=0.7
TICKET_HOST=127.0.0.1
TICKET_PORT=8000
TICKET_LOG_LEVEL=INFO
